generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model marks {
  idmark    Int  @id
  lowballs  Int?
  highballs Int?
}

model reyting {
  idstudent  BigInt   @id
  summ_balls Int?
  students   students @relation(fields: [idstudent], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reyting")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model semesters {
  semester_id         BigInt                @id @default(autoincrement())
  academic_year_start Int                   @db.SmallInt
  term_number         Int                   @db.SmallInt
  start_date          DateTime              @db.Date
  end_date            DateTime              @db.Date
  student_performance student_performance[]

  @@unique([academic_year_start, term_number], map: "uq_semesters_year_term")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model student_groups {
  group_id          BigInt     @id @default(autoincrement())
  group_code        String     @unique(map: "uq_student_groups_code") @db.VarChar(20)
  group_name        String     @db.VarChar(100)
  education_program String     @db.VarChar(200)
  admission_year    Int        @db.SmallInt
  students          students[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model student_performance {
  performance_id  BigInt    @id @default(autoincrement())
  student_id      BigInt
  subject_id      BigInt
  teacher_id      BigInt
  semester_id     BigInt
  assessment_type String    @db.VarChar(30)
  grade           Int?      @db.SmallInt
  passed          Boolean?
  attempt_number  Int       @default(1) @db.SmallInt
  assessment_date DateTime  @db.Date
  semesters       semesters @relation(fields: [semester_id], references: [semester_id], onUpdate: NoAction)
  students        students  @relation(fields: [student_id], references: [student_id], onUpdate: NoAction)
  subjects        subjects  @relation(fields: [subject_id], references: [subject_id], onUpdate: NoAction)
  teachers        teachers  @relation(fields: [teacher_id], references: [teacher_id], onUpdate: NoAction)

  @@unique([student_id, subject_id, semester_id, assessment_type, attempt_number], map: "uq_student_performance")
  @@index([semester_id], map: "idx_performance_semester_id")
  @@index([student_id, semester_id], map: "idx_performance_student_semester")
  @@index([subject_id, semester_id], map: "idx_performance_subject_semester")
  @@index([teacher_id], map: "idx_performance_teacher_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model students {
  student_id          BigInt                @id @default(autoincrement())
  student_number      String                @unique(map: "uq_students_number") @db.VarChar(20)
  last_name           String                @db.VarChar(50)
  first_name          String                @db.VarChar(50)
  middle_name         String?               @db.VarChar(50)
  birth_date          DateTime              @db.Date
  email               String?               @db.VarChar(254)
  status              String                @default("active") @db.VarChar(30)
  group_id            BigInt
  reyting             reyting?
  student_performance student_performance[]
  student_groups      student_groups        @relation(fields: [group_id], references: [group_id], onUpdate: NoAction)
  users               users?

  @@index([group_id], map: "idx_students_group_id")
  @@index([last_name, first_name], map: "idx_students_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subjects {
  subject_id          BigInt                @id @default(autoincrement())
  subject_code        String                @unique(map: "uq_subjects_code") @db.VarChar(20)
  subject_name        String                @unique(map: "uq_subjects_name") @db.VarChar(150)
  total_hours         Int                   @db.SmallInt
  credits             Decimal               @db.Decimal(4, 1)
  student_performance student_performance[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model teachers {
  teacher_id          BigInt                @id @default(autoincrement())
  last_name           String                @db.VarChar(50)
  first_name          String                @db.VarChar(50)
  middle_name         String?               @db.VarChar(50)
  email               String?               @unique(map: "uq_teachers_email") @db.VarChar(254)
  student_performance student_performance[]
  users               users?
}


model roles {
  role_id         BigInt            @id @default(autoincrement())
  role_code       String            @unique(map: "uq_roles_code") @db.VarChar(50)
  role_name       String            @db.VarChar(100)
  description     String?
  role_permissions role_permissions[]
  users           users[]

  @@map("roles")
}

model permissions {
  permission_id   BigInt            @id @default(autoincrement())
  permission_code String            @unique(map: "uq_permissions_code") @db.VarChar(100)
  permission_name String            @db.VarChar(150)
  role_permissions role_permissions[]

  @@map("permissions")
}

model role_permissions {
  role_id       BigInt
  permission_id BigInt
  roles         roles       @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
  permissions   permissions @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@index([permission_id], map: "idx_role_permissions_permission")
  @@map("role_permissions")
}

model users {
  user_id       BigInt     @id @default(autoincrement())
  username      String     @unique(map: "uq_users_username") @db.VarChar(80)
  password_hash String
  role_id       BigInt
  student_id    BigInt?    @unique(map: "uq_users_student")
  teacher_id    BigInt?    @unique(map: "uq_users_teacher")
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  roles         roles      @relation(fields: [role_id], references: [role_id], onDelete: Restrict, onUpdate: NoAction)
  students      students?  @relation(fields: [student_id], references: [student_id], onDelete: SetNull, onUpdate: NoAction)
  teachers      teachers?  @relation(fields: [teacher_id], references: [teacher_id], onDelete: SetNull, onUpdate: NoAction)
  sessions      sessions[]
  audit_logs    audit_logs[]

  @@index([role_id], map: "idx_users_role_id")
  @@map("users")
}

model sessions {
  session_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash   String   @unique(map: "uq_sessions_token") @db.VarChar(64)
  user_id      BigInt
  role_code    String   @db.VarChar(50)
  permissions  String[]
  student_id   BigInt?
  teacher_id   BigInt?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_sessions_user_id")
  @@index([expires_at], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model audit_logs {
  audit_id      BigInt    @id @default(autoincrement())
  actor_user_id BigInt?
  action        String    @db.VarChar(100)
  target_type   String?   @db.VarChar(100)
  target_id     String?
  details       Json?     @db.JsonB
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  users         users?    @relation(fields: [actor_user_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([actor_user_id, created_at], map: "idx_audit_actor_created")
  @@index([target_type, target_id], map: "idx_audit_target")
  @@map("audit_logs")
}
